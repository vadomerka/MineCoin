resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

map $status $log_level {
    ~^5     ERROR;
    ~^4     WARN;
    default INFO;
}
map $http_user_agent $loggable {
    ~^kube-probe 0;
    ~^Wget       0;
    default      1;
}
log_format gateway_json escape=json
    '{'
    '"@timestamp":"$time_iso8601",'
    '"log.level":"$log_level",'
    '"log.logger":"nginx.access",'
    '"service.name":"frontend",'
    '"message":"$request_method $uri $status",'
    '"http.request.method":"$request_method",'
    '"url.path":"$uri",'
    '"http.response.status_code":$status,'
    '"http.request.duration_seconds":$request_time,'
    '"upstream.address":"$upstream_addr",'
    '"request_id":"$request_id",'
    '"client.address":"$remote_addr"'
    '}';

upstream user_service {
    zone user_service 64k;
    server ${USER_SERVICE_UPSTREAM} resolve;
}

upstream finance_service {
    zone finance_service 64k;
    server ${FINANCE_SERVICE_UPSTREAM} resolve;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log gateway_json if=$loggable;

    add_header X-Request-Id $request_id always;

    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;

    location /api/auth/ {
        proxy_pass http://user_service;
    }

    location /api/users {
        proxy_pass http://user_service;
    }

    location /api/wallets {
        proxy_pass http://finance_service;
    }

    location /api/ {
        return 404;
    }

    location / {
        add_header X-Request-Id $request_id always;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
